{
  "name": "c-script-vscode",
  "displayName": "c-script",
  "description": "Soporte oficial del lenguaje c-script: sintaxis y LSP End-to-End Type Safety con TypeScript",
  "version": "1.0.0",
  "publisher": "link-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:c-script"
  ],
  "contributes": {
    "languages": [
      {
        "id": "c-script",
        "aliases": ["c-script", "link", "Link"],
        "extensions": [".link"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "c-script",
        "scopeName": "source.link",
        "path": "./syntaxes/c-script.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "c-script",
        "path": "./snippets/link.json"
      }
    ],
    "commands": [
      {
        "command": "c-script.runTests",
        "title": "Link: Run Behavioral Tests",
        "category": "Link"
      },
      {
        "command": "c-script.build",
        "title": "Link: Build TypeScript Contract",
        "category": "Link"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Link Configuration",
      "properties": {
        "c-script.compilerPath": {
          "type": "string",
          "default": "linkc",
          "description": "Path al binario de linkc / c-script"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
