// examples/site/site.link -- PLAN.md §9.24 Fase 0, "el entregable
// verificable": layout + 3 páginas + datos de `db` que renderiza HTML real,
// escapa por tipo, y tiene tests -- la prueba de que la Fase 0 realmente
// resuelve "portar HTML sin concatenar con +", no solo que cada pieza tipa
// por separado. Usa deliberadamente TODO lo que la Fase 0 shippeó en esta
// misma sesión: `Html` + literal `html\`...\`` (§3.268), `Int.toLocaleString`
// + `String.slugify` (§3.269/§3.270), `for` + `List<T>` completa
// (§3.271/§3.272), y `Map<K,V>` (§3.273).
//
// Extendido para el entregable de la Fase 1 (PLAN.md §9.24, línea ~1257):
// "`examples/site/` con cookie de CSRF real, formulario que POSTea, 404
// propio, headers de SEO, drenado graceful probado con un `pm2 restart`
// bajo carga". El 404 (A10) ya estaba. Lo nuevo acá: SEO (`metaTags`/
// `openGraphTags`/`canonicalLink`, A9) en `pageLayout`, y una página de
// contacto real con `@csrf` (C1+C2) -- un form que hace `fetch()` con el
// header `x-csrf-token` leído de `document.cookie`, porque un `<form>` HTML
// plano no puede mandar un header custom en su POST. El drenado bajo carga
// vive en `cli_graceful_drain.rs` (C14), no acá -- este archivo es contenido
// de página, no infraestructura de proceso.
type City = {
  id: Int, name: String, province: String, population: Int,
}

type ContactMessage = {
  id: Int, name: String, message: String,
}

type Meta = { name: String, content: String }
type Og = { property: String, content: String }

db {
  cities: City[],
  contactMessages: ContactMessage[],
}

// ---- layout compartido, con SEO (A9: description/canonical/og:*) ----
fn pageLayout(title: String, description: String, path: String, main: Html) -> Html {
  let seoHead = (metaTags([
    Meta { name: "description", content: description },
    Meta { name: "viewport", content: "width=device-width, initial-scale=1" },
  ]) + "\n" + openGraphTags([
    Og { property: "og:title", content: title },
    Og { property: "og:type", content: "website" },
    Og { property: "og:description", content: description },
  ]) + "\n" + canonicalLink("https://example.cscript.dev" + path)).rawHtml();
  html`<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>${title}</title>
  ${seoHead}
</head>
<body>
  <header><a href="/">Inicio</a> · <a href="/contacto">Contacto</a></header>
  <main>${main}</main>
  <footer>c-script demo site</footer>
</body>
</html>`
}

// ---- página 1: inicio, provincias agrupadas (groupBy + Map + slugify) ----
fn provinceItem(pair: (String, City[])) -> Html {
  let province = pair.0;
  let count = pair.1.length();
  html`<li><a href="/provincia/${province.slugify()}">${province}</a> (${count.toLocaleString("es-ES")} ciudades)</li>`
}

// ---- página 2: listado completo de ciudades (sortBy + for + toLocaleString) ----
fn cityRow(c: City) -> Html {
  html`<tr><td>${c.name}</td><td>${c.province}</td><td>${c.population.toLocaleString("es-ES")}</td></tr>`
}

// ---- página 3: detalle de una ciudad (match sobre Optional, not-found real) ----
fn cityDetailBody(c: City) -> Html {
  html`<h1>${c.name}</h1><p>Provincia: ${c.province}</p><p>Población: ${c.population.toLocaleString("es-ES")} habitantes.</p>`
}

fn notFoundBody(id: Int) -> Html {
  html`<h1>No encontrado</h1><p>No existe ninguna ciudad con id ${id}.</p>`
}

// ---- página 4: contacto, con protección CSRF real (GRAMMAR.md §3.278) ----
// Un <form> HTML plano no puede mandar un header custom en su POST, así que
// el envío es un fetch() de JS leyendo la cookie `_csrf` (httpOnly:false a
// propósito, ver §3.278) y reenviándola como header `x-csrf-token` -- el
// mecanismo de doble-submit tal cual está documentado, no una simulación.
fn contactFormBody() -> Html {
  html`<h1>Contacto</h1>
<form id="contactForm">
  <label>Nombre <input type="text" id="contactName" required></label>
  <label>Mensaje <textarea id="contactMessage" required></textarea></label>
  <button type="submit">Enviar</button>
</form>
<div id="contactResult"></div>
<script>
function cscriptCookie(name) {
  var match = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
  return match ? match.pop() : '';
}
document.getElementById('contactForm').addEventListener('submit', function (ev) {
  ev.preventDefault();
  var body = JSON.stringify({
    name: document.getElementById('contactName').value,
    message: document.getElementById('contactMessage').value
  });
  fetch('/Site/submitContact', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-csrf-token': cscriptCookie('_csrf') },
    body: body
  }).then(function (res) {
    return res.text();
  }).then(function (resultHtml) {
    document.getElementById('contactResult').innerHTML = resultHtml;
  });
});
</script>`
}

fn contactThanksBody(name: String) -> Html {
  html`<p>Gracias, ${name}. Recibimos tu mensaje.</p>`
}

service Site {
  // PLAN.md §9.24 Fase 1 ítem A10 (GRAMMAR.md §3.274): la página que
  // `linkc serve` invoca automáticamente para CUALQUIER path que no
  // matchea nada -- 404 real, no el JSON del motor.
  @notFound rpc pageNotFound() -> Html {
    pageLayout("Página no encontrada", "La página que buscás no existe.", "/404", html`<h1>404</h1><p>La página que buscás no existe.</p>`)
  }
  rpc home() -> Html {
    let grouped = db.cities.all().groupBy(| c: City | {
      c.province
    }
    );
    let items = grouped.entries().map(provinceItem);
    pageLayout("Inicio", "Directorio de provincias y ciudades de España.", "/", html`<h1>Provincias</h1><ul>${items}</ul>`)
  }
  rpc cityList() -> Html {
    let cities = db.cities.all().sortBy(| c: City | {
      c.name
    }
    );
    let rows = cities.map(cityRow);
    pageLayout("Ciudades", "Listado completo de ciudades.", "/ciudades", html`<h1>Ciudades</h1><table><tbody>${rows}</tbody></table>`)
  }
  rpc cityDetail(id: Int) -> Html {
    match db.cities.find(id) {
      c: City => pageLayout(c.name, "Información de " + c.name + ".", "/ciudad/" + id.toString(), cityDetailBody(c)),
      null => pageLayout("No encontrado", "No existe ninguna ciudad con ese id.", "/ciudad/" + id.toString(), notFoundBody(id)),
    }
  }

  // GRAMMAR.md §3.278: cookie httpOnly:false a propósito -- JS del mismo
  // origen (`cscriptCookie()` en `contactFormBody`) necesita poder leerla
  // para reenviarla como header. Se renueva en cada visita a la página.
  rpc contactPage() -> Html {
    response.setCookie("_csrf", crypto.uuid().toString(), { httpOnly: false, sameSite: "strict" });
    pageLayout("Contacto", "Formulario de contacto del sitio de ejemplo.", "/contacto", contactFormBody())
  }

  @csrf
  rpc submitContact(name: String, message: String) -> Html {
    db.contactMessages.insert(ContactMessage { id: 0, name: name, message: message });
    contactThanksBody(name)
  }
}

test "pageNotFound (@notFound) devuelve una pagina 404 real" {
  let out = Site.pageNotFound();
  let s = out.toString();
  assert(s.contains("<!doctype html>"));
  assert(s.contains("<h1>404</h1>"));
}

test "home agrupa por provincia con el conteo correcto" {
  db.cities.insert(City {
    id: 0, name: "Malaga", province: "Andalucia", population: 578460
  }
  );
  db.cities.insert(City {
    id: 0, name: "Marbella", province: "Andalucia", population: 147557
  }
  );
  db.cities.insert(City {
    id: 0, name: "Bilbao", province: "PaisVasco", population: 345821
  }
  );
  let out = Site.home();
  let s = out.toString();
  assert(s.contains("<!doctype html>"));
  assert(s.contains("Andalucia"));
  assert(s.contains("PaisVasco"));
  // "2 ciudades" agrupadas bajo Andalucia -- el número formateado (sin
  // separador de miles, es chico) confirma que toLocaleString corrió.
  assert(s.contains("(2 ciudades)"));
  assert(s.contains("(1 ciudades)"));
}

test "cityList ordena alfabeticamente y formatea la poblacion con separador de miles" {
  db.cities.insert(City {
    id: 0, name: "Zaragoza", province: "Aragon", population: 675301
  }
  );
  db.cities.insert(City {
    id: 0, name: "Alicante", province: "Valencia", population: 337482
  }
  );
  let out = Site.cityList();
  let s = out.toString();
  assert(s.contains("<table>"));
  // "675.301" -- separador de miles es-ES, prueba real de Int.toLocaleString.
  assert(s.contains("675.301"));
  assert(s.contains("337.482"));
  // orden alfabetico: Alicante antes que Zaragoza en el HTML.
  assert(s.indexOf("Alicante") < s.indexOf("Zaragoza"));
}

test "cityDetail con id existente muestra la ciudad" {
  let created = db.cities.insert(City {
    id: 0, name: "Sevilla", province: "Andalucia", population: 688711
  }
  );
  let out = Site.cityDetail(created.id);
  let s = out.toString();
  assert(s.contains("<h1>Sevilla</h1>"));
  assert(s.contains("688.711"));
}

test "cityDetail con id inexistente muestra la pagina de no encontrado" {
  let out = Site.cityDetail(999999);
  let s = out.toString();
  assert(s.contains("No encontrado"));
  assert(s.contains("999999"));
}

test "el nombre de una ciudad se escapa por tipo, nunca se inyecta HTML crudo" {
  let created = db.cities.insert(City {
    id: 0, name: "<script>alert(1)</script>", province: "Test", population: 1,
  }
  );
  let out = Site.cityDetail(created.id);
  let s = out.toString();
  assert(!s.contains("<script>alert(1)</script>"));
  assert(s.contains("&lt;script&gt;"));
}

test "el listado completo tambien escapa nombres con caracteres especiales" {
  db.cities.insert(City {
    id: 0, name: "A & B \"Ciudad\"", province: "Test", population: 1
  }
  );
  let out = Site.cityList();
  let s = out.toString();
  assert(s.contains("&amp;"));
  assert(!s.contains("A & B"));
}

test "pageLayout agrega meta description, Open Graph y canonical link (A9)" {
  let out = Site.home();
  let s = out.toString();
  assert(s.contains("<meta name=\"description\" content=\"Directorio de provincias y ciudades de Espa"));
  assert(s.contains("<meta property=\"og:title\" content=\"Inicio\">"));
  assert(s.contains("<link rel=\"canonical\" href=\"https://example.cscript.dev/\">"));
}

test "cada pagina tiene su propio canonical (path distinto)" {
  let out = Site.cityList();
  let s = out.toString();
  assert(s.contains("https://example.cscript.dev/ciudades"));
}

test "contactPage renderiza el formulario y arma el fetch con x-csrf-token" {
  let out = Site.contactPage();
  let s = out.toString();
  assert(s.contains("<form id=\"contactForm\">"));
  assert(s.contains("x-csrf-token"));
  assert(s.contains("/Site/submitContact"));
}

test "submitContact guarda el mensaje y escapa el nombre en la respuesta" {
  let out = Site.submitContact("<b>Ada</b>", "hola");
  let s = out.toString();
  assert(!s.contains("<b>Ada</b>"));
  assert(s.contains("&lt;b&gt;Ada&lt;/b&gt;"));
  assert(db.contactMessages.count() == 1);
}
