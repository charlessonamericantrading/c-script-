type User = {
  id: Int,
  name: String,
  email: String,
  role: Role,
  bio?: String,
  deletedAt: String?,
  // Timestamp (GRAMMAR.md §3.31): v0 no tiene ningún mecanismo para
  // construir uno DESDE el lenguaje (sin now(), sin auto-stamping en
  // insert) -- así que quien lo provee es el cliente, en el momento de
  // crear, no el servidor. Ver NewUser/validate más abajo.
  createdAt: Timestamp,
}

enum Role { Admin, Member, Guest }

// "DB tipada" v0 (GRAMMAR.md §3.12): toda colección necesita un campo
// `id: Int` -- es lo que hace posible que `insert` pida Omit<User,"id">
// en vez del struct completo, sin romper la creación de abajo.
db {
  users: User[],
}

enum ValidationError {
  InvalidEmail { field: String },
  TooShort     { field: String, min: Int },
}

type NewUser = {
  name: String,
  email: String,
  createdAt: Timestamp,
}

// Forma completa que espera `db.users.insert` (Omit<User,"id"> --
// estructuralmente idéntica: los mismos campos de User salvo `id`).
// `NewUser` (arriba) sigue siendo la forma PÚBLICA, chica, que ve el
// frontend -- acá se completan los defaults de un usuario nuevo (role
// Member, deletedAt null) antes de insertar.
type NewUserRecord = {
  name: String,
  email: String,
  role: Role,
  bio?: String,
  deletedAt: String?,
  createdAt: Timestamp,
}

enum ValidateResult {
  Ok  { value: NewUserRecord },
  Err { error: ValidationError },
}

fn validate(input: NewUser) -> ValidateResult {
  if !input.email.contains("@") {
    ValidateResult.Err { error: ValidationError.InvalidEmail { field: "email" } }
  } else if input.name.length() < 2 {
    ValidateResult.Err { error: ValidationError.TooShort { field: "name", min: 2 } }
  } else {
    // El primer usuario creado es Admin, el resto Member -- sin esto, con
    // `db.new` arrancando SIEMPRE vacío (sin seed), nadie podría llegar
    // nunca a `Role.Admin` para ejercer el `update` gateado más abajo (auth
    // v0, GRAMMAR.md §3.14). Bootstrapping realista y chico: una migración
    // real resolvería esto sembrando un admin aparte, pero el lenguaje hoy
    // no tiene ningún mecanismo de seed/migración -- esto es lo mínimo que
    // hace el demo usable de punta a punta sin inventar uno.
    let role: Role = if db.users.all().length() == 0 { Role.Admin {} } else { Role.Member {} };
    ValidateResult.Ok { value: NewUserRecord { name: input.name, email: input.email, role: role, deletedAt: null, createdAt: input.createdAt } }
  }
}

service Users {
  rpc list(limit: Int = 20) -> User[] {
    db.users.all().take(limit)
  }

  rpc getById(id: Int) -> User? {
    db.users.find(id)
  }

  rpc create(input: NewUser) -> Result<User, ValidationError> {
    match validate(input) {
      ValidateResult.Ok  { value: v } => Result.Ok  { value: db.users.insert(v) },
      ValidateResult.Err { error: e } => Result.Err { error: e },
    }
  }

  // Auth v0 (GRAMMAR.md §3.14): solo un Admin puede editar registros ajenos.
  // Sin este decorator, cualquiera podría reescribir cualquier campo de
  // cualquier usuario -- el mismo rpc de siempre, ahora con un guard real.
  @requires(Role.Admin)
  rpc update(id: Int, patch: Patch<User>) -> User {
    db.users.applyPatch(id, patch)
  }

  @requires(Role.Admin)
  rpc remove(id: Int) -> Bool {
    db.users.delete(id)
  }


  // Login v0 (GRAMMAR.md §3.14): busca por email SOLAMENTE -- verificar
  // contraseña/hash de credenciales queda fuera de esta ronda a propósito,
  // es su propio problema de seguridad, no algo para meter de paso. Emite
  // un token opaco de sesión con el ROL real del usuario encontrado (no un
  // rol elegido por el caller); `null` si no hay match, nunca un error.
  rpc login(email: String) -> String? {
    let matches = db.users.all().filter(|u: User| { u.email == email });
    if matches.length() > 0 {
      auth.createSession(matches[0].role)
    } else {
      null
    }
  }

  // logout necesita @authenticated: sin sesión válida no hay NADA que
  // destruir, y sin la anotación `auth.destroySession()` no sabría cuál es
  // "la propia" sesión (a propósito no toma un token como argumento -- ver
  // GRAMMAR.md §3.14, hallazgo del review adversarial de esta ronda).
  @authenticated
  rpc logout() -> Void {
    auth.destroySession()
  }

  // Closures reales (GRAMMAR.md §3.10): `role` viene del parámetro de ESTE
  // rpc, no de `db.users` -- el closure lo captura del scope que lo rodea
  // (captura léxica real, no una referencia a `fn` con nombre).
  rpc listByRole(role: Role) -> User[] {
    db.users.all().filter(|u: User| { u.role == role })
  }

  // `.map` (GRAMMAR.md §3.10): cambia el tipo de elemento de la lista
  // (User -> String), a diferencia de `.filter` que siempre preserva T.
  rpc listEmails() -> String[] {
    db.users.all().map(|u: User| { u.email })
  }

  // Narrowing de uniones (GRAMMAR.md §3.9): la búsqueda flexible más común
  // en una API real -- un mismo parámetro que puede ser un id (Int) o un
  // email (String). Los dos miembros son distinguibles de forma real (un
  // valor de query solo puede ser Int o String, nunca ambos), así que el
  // match tipa. Ambos arms devuelven User[] (no User?) para no necesitar
  // ninguna conversión Optional<->List que el lenguaje no tiene todavía.
  rpc findByIdOrEmail(query: Int | String) -> User[] {
    match query {
      id: Int => db.users.all().filter(|u: User| { u.id == id }),
      email: String => db.users.all().filter(|u: User| { u.email == email }),
    }
  }

  // "Streaming real" v0 (GRAMMAR.md §3.13): la firma declara el ELEMENTO
  // (User, igual que un rpc normal), pero el cuerpo tiene que devolver la
  // secuencia YA CALCULADA entera -- acá, la misma lista que ya arma
  // `list` de arriba. El servidor la manda como eventos SSE reales, uno
  // por usuario, en vez de un solo JSON. Alcance explícito: NO se
  // suscribe a usuarios creados después -- eso necesitaría una capa de
  // pub-sub sobre `db` que no existe todavía.
  stream watchAll() -> User {
    db.users.all()
  }
}
