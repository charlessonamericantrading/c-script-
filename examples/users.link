type User = {
  id: Int,
  name: String,
  email: String,
  role: Role,
  bio?: String,
  deletedAt: String?,
}

enum Role { Admin, Member, Guest }

// "DB tipada" v0 (GRAMMAR.md §2.1): toda colección necesita un campo
// `id: Int` -- es lo que hace posible que `insert` pida Omit<User,"id">
// en vez del struct completo, sin romper la creación de abajo.
db {
  users: User[],
}

enum ValidationError {
  InvalidEmail { field: String },
  TooShort     { field: String, min: Int },
}

type NewUser = {
  name: String,
  email: String,
}

// Forma completa que espera `db.users.insert` (Omit<User,"id"> --
// estructuralmente idéntica: los mismos campos de User salvo `id`).
// `NewUser` (arriba) sigue siendo la forma PÚBLICA, chica, que ve el
// frontend -- acá se completan los defaults de un usuario nuevo (role
// Member, deletedAt null) antes de insertar.
type NewUserRecord = {
  name: String,
  email: String,
  role: Role,
  bio?: String,
  deletedAt: String?,
}

enum ValidateResult {
  Ok  { value: NewUserRecord },
  Err { error: ValidationError },
}

fn validate(input: NewUser) -> ValidateResult {
  if !input.email.contains("@") {
    ValidateResult.Err { error: ValidationError.InvalidEmail { field: "email" } }
  } else if input.name.length() < 2 {
    ValidateResult.Err { error: ValidationError.TooShort { field: "name", min: 2 } }
  } else {
    ValidateResult.Ok { value: NewUserRecord { name: input.name, email: input.email, role: Role.Member {}, deletedAt: null } }
  }
}

service Users {
  rpc list(limit: Int = 20) -> User[] {
    db.users.all().take(limit)
  }

  rpc getById(id: Int) -> User? {
    db.users.find(id)
  }

  rpc create(input: NewUser) -> Result<User, ValidationError> {
    match validate(input) {
      ValidateResult.Ok  { value: v } => Result.Ok  { value: db.users.insert(v) },
      ValidateResult.Err { error: e } => Result.Err { error: e },
    }
  }

  rpc update(id: Int, patch: Patch<User>) -> User {
    db.users.applyPatch(id, patch)
  }
}
