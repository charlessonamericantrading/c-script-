// Generado automáticamente por linkc v1.69.0 — no editar a mano.

export type Result<T, E> = { type: "Ok"; value: T } | { type: "Err"; error: E };
export type Patch<T> = Partial<T>;

export interface User {
  id: number;
  name: string;
  email: string;
  role: Role;
  bio?: string;
  deletedAt: string | null;
  createdAt: string;
}

export type Role = "Admin" | "Member" | "Guest";

export type ValidationError =
  | { type: "InvalidEmail"; field: string }
  | { type: "TooShort"; field: string; min: number }
;

export interface NewUser {
  name: string;
  email: string;
  createdAt: string;
}

export interface NewUserRecord {
  name: string;
  email: string;
  role: Role;
  bio?: string;
  deletedAt: string | null;
  createdAt: string;
}

export type ValidateResult =
  | { type: "Ok"; value: NewUserRecord }
  | { type: "Err"; error: ValidationError }
;

export interface UsersClient {
  list(limit?: number): Promise<User[]>;
  getById(id: number): Promise<User | null>;
  create(input: NewUser): Promise<Result<User, ValidationError>>;
  update(id: number, patch: Patch<User>): Promise<User>;
  remove(id: number): Promise<boolean>;
  login(email: string): Promise<string | null>;
  logout(): Promise<void>;
  listByRole(role: Role): Promise<User[]>;
  listEmails(): Promise<string[]>;
  findByIdOrEmail(query: number | string): Promise<User[]>;
  watchAll(): AsyncIterable<User>;
  setToken(token: string | null): void;
}


