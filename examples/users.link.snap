import type { NewUser, Patch, Result, Role, User, UsersClient, ValidationError } from "./contract";
import { isResult_User_ValidationError, isUser } from "./validators.ts";

export class LinkTransportError extends Error {}

export class LinkValidationError extends Error {
  rpcName: string;
  received: unknown;
  constructor(rpcName: string, received: unknown) {
    super(`la respuesta de '${rpcName}' no matchea el contrato declarado`);
    this.rpcName = rpcName;
    this.received = received;
  }
}

export function isOk<T, E>(result: { ok: true; value: T } | { ok: false; error: E }): result is { ok: true; value: T } {
  return result.ok === true;
}

export function isErr<T, E>(result: { ok: true; value: T } | { ok: false; error: E }): result is { ok: false; error: E } {
  return result.ok === false;
}

class UsersClientImpl implements UsersClient {
  private baseUrl: string;
  private token: string | null = null;
  constructor(baseUrl: string) {
    this.baseUrl = baseUrl;
  }

  setToken(token: string | null): void {
    this.token = token;
  }

  async list(limit?: number): Promise<User[]> {
    const res = await fetch(`${this.baseUrl}/Users/list`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({ limit }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!((Array.isArray(json) && json.every((item: unknown) => isUser(item))))) throw new LinkValidationError("list", json);
    return json as User[];
  }

  async getById(id: number): Promise<User | null> {
    const res = await fetch(`${this.baseUrl}/Users/getById`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({ id }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!((json === null || isUser(json)))) throw new LinkValidationError("getById", json);
    return json as User | null;
  }

  async create(input: NewUser): Promise<Result<User, ValidationError>> {
    const res = await fetch(`${this.baseUrl}/Users/create`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({ input }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!(isResult_User_ValidationError(json))) throw new LinkValidationError("create", json);
    return json as Result<User, ValidationError>;
  }

  async update(id: number, patch: Patch<User>): Promise<User> {
    const res = await fetch(`${this.baseUrl}/Users/update`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({ id, patch }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!(isUser(json))) throw new LinkValidationError("update", json);
    return json as User;
  }

  async remove(id: number): Promise<boolean> {
    const res = await fetch(`${this.baseUrl}/Users/remove`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({ id }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!(typeof json === "boolean")) throw new LinkValidationError("remove", json);
    return json as boolean;
  }

  async login(email: string): Promise<string | null> {
    const res = await fetch(`${this.baseUrl}/Users/login`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({ email }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!((json === null || typeof json === "string"))) throw new LinkValidationError("login", json);
    return json as string | null;
  }

  async logout(): Promise<void> {
    const res = await fetch(`${this.baseUrl}/Users/logout`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({  }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!(true)) throw new LinkValidationError("logout", json);
    return json as void;
  }

  async listByRole(role: Role): Promise<User[]> {
    const res = await fetch(`${this.baseUrl}/Users/listByRole`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({ role }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!((Array.isArray(json) && json.every((item: unknown) => isUser(item))))) throw new LinkValidationError("listByRole", json);
    return json as User[];
  }

  async listEmails(): Promise<string[]> {
    const res = await fetch(`${this.baseUrl}/Users/listEmails`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({  }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!((Array.isArray(json) && json.every((item: unknown) => typeof item === "string")))) throw new LinkValidationError("listEmails", json);
    return json as string[];
  }

  async findByIdOrEmail(query: number | string): Promise<User[]> {
    const res = await fetch(`${this.baseUrl}/Users/findByIdOrEmail`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({ query }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    const json: unknown = await res.json();
    if (!((Array.isArray(json) && json.every((item: unknown) => isUser(item))))) throw new LinkValidationError("findByIdOrEmail", json);
    return json as User[];
  }

  async *watchAll(): AsyncIterable<User> {
    const res = await fetch(`${this.baseUrl}/Users/watchAll`, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...(this.token ? { Authorization: `Bearer ${this.token}` } : {}) },
      body: JSON.stringify({  }),
    });
    if (!res.ok) throw new LinkTransportError(`HTTP ${res.status}`);
    if (!res.body) throw new LinkTransportError("el servidor no devolvió un body de stream");
    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    let buffer = "";
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      let sep: number;
      while ((sep = buffer.indexOf("\n\n")) !== -1) {
        const frame = buffer.slice(0, sep);
        buffer = buffer.slice(sep + 2);
        if (!frame.startsWith("data: ")) continue;
        const json: unknown = JSON.parse(frame.slice(6));
        if (!(isUser(json))) throw new LinkValidationError("watchAll", json);
        yield json as User;
      }
    }
  }

}

export function createUsersClient(baseUrl: string): UsersClient {
  return new UsersClientImpl(baseUrl);
}


